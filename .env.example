APP_URL=http://localhost:3000
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# Generate with: openssl rand -hex 32
SESSION_KEY=
DATABASE_PATH=./data/mystery.sqlite
# Optional override. Defaults to discogs-masters.sqlite next to DATABASE_PATH.
# DISCOGS_MASTER_INDEX_PATH=./data/discogs-masters.sqlite
DISCOGS_USER_AGENT=MysteryDJ/0.1
# Optional Spotify connection. Local APP_URL must use 127.0.0.1, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
