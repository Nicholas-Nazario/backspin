{
  "name": "backspin",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
